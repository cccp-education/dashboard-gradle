<!DOCTYPE html>
<html lang="fr" xmlns:th="http://www.thymeleaf.org">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${page.title}">Dashboard Workspace CCCP</title>
    <link rel="stylesheet" href="vendor/bootstrap.min.css">
    <link rel="stylesheet" th:href="@{styles.css}" href="styles.css">
</head>
<body>
<nav class="navbar navbar-dark bg-dark">
    <div class="container-fluid">
        <span class="navbar-brand mb-0 h1" th:text="${page.title}">Dashboard Workspace CCCP</span>
        <span class="navbar-text text-light">
            <span th:text="${page.stats.boroughCount}">0</span> boroughs —
            <span th:text="${page.stats.epicCount}">0</span> epics —
            <span class="badge bg-success" th:text="${page.progress.percent + ' %'}">0 %</span>
        </span>
    </div>
</nav>

<main class="container-fluid mt-4">
    <div class="panorama">
        <!-- ZONE VISION (35) -->
        <section class="zone-vision">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Vision — chaîne MVP0</h2>
                    <span class="text-muted small">A1 → A4</span>
                </div>
                <div class="card-body">
                    <ol class="path">
                        <li th:each="ring : ${page.rings}" th:attr="data-state=${ring.state}">
                            <div class="d-flex justify-content-between align-items-baseline">
                                <span><span class="ring" th:text="${ring.ring}">A1</span>
                                    <span th:text="${ring.label}">Corpus</span></span>
                                <span class="stat" th:text="${ring.percent + ' %'}">0 %</span>
                            </div>
                            <div class="mini"><span th:style="|width:${ring.percent}%|"></span></div>
                            <small class="text-muted"
                                   th:text="${ring.projects + ' — ' + ring.donePoints + '/' + ring.totalPoints + ' pts'}">
                                projects — 0/0 pts</small>
                        </li>
                    </ol>
                    <p class="text-muted py-3 mb-0" th:if="${#lists.isEmpty(page.rings)}">
                        Aucun anneau du critical path configuré.
                    </p>

                    <h3 class="h6 mt-4">Jalons MVP0</h3>
                    <ul class="milestones list-unstyled mb-0">
                        <li th:each="milestone : ${page.milestones}">
                            <span class="dot" th:classappend="${'dot-' + milestone.status}"></span>
                            <span th:text="${milestone.label}">Jalon</span>
                            <small class="text-muted"
                                   th:text="${milestone.date + ' — ' + milestone.borough + ' (' + milestone.dagLevel + ')'}">
                                2026-06-18 — Borough</small>
                        </li>
                        <li class="text-muted py-2" th:if="${#lists.isEmpty(page.milestones)}">
                            Aucun jalon disponible.
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- ZONE AVANCEMENT (35) -->
        <section class="zone-progress">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Avancement</h2>
                    <span class="text-muted small"
                          th:text="${page.progress.donePoints + ' / ' + page.progress.totalPoints + ' pts'}">0 / 0 pts</span>
                </div>
                <div class="card-body">
                    <div class="global-progress mb-3">
                        <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                             th:attr="aria-valuenow=${page.progress.percent}">
                            <div class="progress-bar bg-success" th:style="|width:${page.progress.percent}%|"
                                 th:text="${page.progress.percent + ' %'}">0 %</div>
                        </div>
                        <small class="text-muted"
                               th:text="${page.progress.doneEpics + ' / ' + page.progress.totalEpics + ' EPICs terminés'}">
                            0 / 0 EPICs</small>
                    </div>
                    <div class="bars">
                        <div class="bar-row" th:each="borough : ${page.boroughBars}">
                            <a class="name" th:href="${borough.slugFile}" th:text="${borough.name}"
                               th:title="${borough.project + ' — ' + borough.dagLevel}">Borough</a>
                            <span class="bar"><span th:style="|width:${borough.percent}%|"></span></span>
                            <span class="pct" th:text="${borough.hasPoints ? borough.percent + ' %' : '—'}">0 %</span>
                        </div>
                        <p class="text-muted py-3 mb-0" th:if="${#lists.isEmpty(page.boroughBars)}">
                            Aucun borough crawlé.
                        </p>
                    </div>
                </div>
            </div>
        </section>

        <!-- ZONE STRUCTURE (30) -->
        <section class="zone-structure">
            <div class="card dashboard-card h-100">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Structure</h2>
                    <span class="text-muted small">N0 → N4</span>
                </div>
                <div class="card-body">
                    <div class="dag-levels">
                        <div class="dag-level" th:each="level : ${page.dagLevels}">
                            <h3 class="h6" th:text="${level.level}">N0</h3>
                            <div class="chips">
                                <a class="chip" th:each="node : ${level.nodes}" th:href="${node.slugFile}"
                                   th:title="${node.project + ' — ' + node.percent + ' %'}">
                                    <span class="dot"></span><span th:text="${node.name}">Borough</span>
                                </a>
                            </div>
                        </div>
                        <p class="text-muted py-3 mb-0" th:if="${#lists.isEmpty(page.dagLevels)}">
                            Aucune couche DAG disponible.
                        </p>
                    </div>
                    <p class="text-muted small mt-3 mb-0">
                        La structure navigable appartient à Brooklin Flow. Ici, ALGER résume les couches
                        et ouvre les fiches borough.
                    </p>
                </div>
            </div>
        </section>
    </div>
</main>

<footer class="bg-dark text-white mt-5 py-3">
    <div class="container text-center">
        <p class="mb-0">&copy; 2026 CCCP Education — Dashboard workspace —
            <span th:text="${page.sessionCount}">0</span> sessions</p>
    </div>
</footer>
</body>
</html>
